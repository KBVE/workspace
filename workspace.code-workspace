{
  "folders": [
    { "path": "." }
  ],
  "settings": {
    // pnpm keeps the real package behind a symlink in node_modules/.pnpm, so
    // the TS server has to use the workspace copy to resolve astro presets.
    "typescript.tsdk": "node_modules/typescript/lib",
    "typescript.enablePromptUseWorkspaceTsdk": true,
    "files.exclude": {
      "**/node_modules": true,
      "**/target": true,
      "**/.moon/cache": true,
      "**/dist": true,
      "**/packages/protobuf/gen": true
    },
    "search.exclude": {
      "**/pnpm-lock.yaml": true,
      "**/packages/protobuf/gen": true
    },
    "rust-analyzer.linkedProjects": ["Cargo.toml"],
    "editor.formatOnSave": true
  },
  "extensions": {
    "recommendations": [
      "moonrepo.moon-console",
      "rust-lang.rust-analyzer",
      "astro-build.astro-vscode",
      "bufbuild.vscode-buf"
    ]
  }
}
