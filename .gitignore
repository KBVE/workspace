# --- secrets -----------------------------------------------------------
# Secrets never enter this repository, encrypted or otherwise. They live in
# a secret manager; env.sh materialises them locally.
.env
.env.*
!.env.example
env.sh
secrets/
*.pem
*.key

# --- node ---------------------------------------------------------------
node_modules/
.pnpm-store/
*-debug.log*

# --- build output -------------------------------------------------------
dist/
build/
out/
target/
.astro/
.vite/
.output/

# --- test output --------------------------------------------------------
# Playwright writes traces, screenshots, and videos on failure. Projects point
# `outputDir` at their own e2e/.artifacts, but the defaults are listed too: a
# project added without that setting drops test-results/ at its root, and the
# first failing run is the one that notices.
test-results/
playwright-report/
blob-report/
.artifacts/
.last-run.json

# --- moon ---------------------------------------------------------------
.moon/cache
.moon/docker

# --- worktrees -----------------------------------------------------------
# tools/worktree/add.sh writes this into each worktree to point Cargo at the
# main checkout's target/. It names an absolute path on one machine, so it is
# per-worktree state, not configuration. The main checkout has no .cargo/ at
# all -- the directory is allowlisted in the pre-commit hook because a worktree
# is a place someone commits from.
.cargo/config.toml

# --- editor / os --------------------------------------------------------
.idea/
.DS_Store
Thumbs.db
*.swp

# --- agent and tool scratch ---------------------------------------------
# Per-machine state written by editors and coding agents. None of it is
# reproducible on another clone, and all of it is noise in a diff.
#
# .hallmark/log.json reached main once already, in the same `git add -A` that
# swept in the game tree. The pre-commit hook now refuses any new top-level
# dot-directory that is not on its allowlist, because the next tool to invent
# one will not be listed here either.
.hallmark/
.aider*
.cursor/
.claude/settings.local.json
