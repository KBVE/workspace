# Names only -- values live in /Users/alappatel/workspace/.env, which is outside
# every repo and never copied. Load them with `. ./env.sh` from that directory;
# `. ./env.sh --check` reads this file and reports anything unset.
#
# Do NOT create a .env here. One file with values, or the copies drift.

# git.kbve.com, for `git lfs pull` of the character art
FORGEJO_USER=
FORGEJO_TOKEN=

# itch.io butler; same name as the repository secret in Actions
BUTLER_API_KEY=
