node = "26.8.1"
pnpm = "11.24.0"
rust = "1.98.0"
moon = "2.5.3"
godot = "4.7.2"
# The python packages under packages/python. moon 2.5 has no built-in python
# toolchain plugin -- declaring `python:` in .moon/toolchains.yml fails with "a
# locator is required for plugins" -- so uv runs as a system command against
# this pinned binary.
#
# The interpreter is deliberately not pinned here. uv resolves it from each
# project's .python-version and downloads its own build, so a pin here would be
# a second claim that loses silently: when both existed, proto installed one
# patch release and every venv was still built from uv's. proto pins uv; uv
# pins python.
uv = "0.12.7"

[plugins]
# Local schema plugin; proto has no Godot tool built in or in the community
# registry (`proto plugin search godot` is empty as of 0.61).
godot = "file://./.proto/plugins/godot.toml"
