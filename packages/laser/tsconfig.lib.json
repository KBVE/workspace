{
  // Declaration emit only -- vite-plugin-dts reads this, nothing else does.
  // The exclude list is what keeps test files out of the published .d.ts.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  // *.testing.ts holds fixtures shared between spec files. They are not tests,
  // so vitest must not collect them, and they are not library code, so they
  // must not reach the published declarations either.
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.testing.ts"
  ]
}
