{
  "name": "@kbve/laser",
  "version": "0.2.0",
  "description": "Phaser + React Three Fiber integration layer for React 19",
  "keywords": [
    "phaser",
    "react",
    "r3f",
    "react-three-fiber",
    "gamedev",
    "three.js"
  ],
