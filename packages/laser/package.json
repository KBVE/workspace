      "types": "./phaser.d.ts"
    },
    "./r3f": {
      "import": "./r3f.es.js",
      "types": "./r3f.d.ts"
    }
  },
  "files": [
    "*.es.js",
    "laser.es.js",
    "index.d.ts",
    "**/*.d.ts",
    "*.md"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
