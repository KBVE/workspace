  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": "./laser.es.js",
      "types": "./index.d.ts"
    },
    "./ecs": {
      "import": "./ecs.es.js",
      "types": "./ecs.d.ts"
    },
    "./mecs": {
