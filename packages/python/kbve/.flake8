[flake8]
exclude =
	.git,
	__pycache__,
	build,
	dist,
	.tox,
	venv,
	.venv,
	.pytest_cache
max-line-length = 120
extend-ignore = E203, E221
per-file-ignores =
	# pycodestyle mis-tokenizes f-string contents under PEP 701 (py3.12): the
	# format spec in f"frame_{idx:03d}.png" reads as a bare colon, and a
	# semicolon inside f"failed ({e}); skipped" reads as two statements. Both
	# are inside string literals.
	kbve/blender/model_sprites.py: E231, E702
	# Same tokenizer bug, and the inline SVG hits it hardest: every CSS
	# declaration in a style attribute reads as a bare colon, and so does
	# every :.1f coordinate format spec.
	kbve/svg/chart.py: E231, E702
	# And again in kbve.seo, where the findings are f-strings carrying
	# semicolons in prose and the report's columns are :<4 width specs.
	kbve/seo/pages.py: E702
	kbve/seo/rules.py: E702
	kbve/seo/report.py: E231
	kbve/svg/dag.py: E231, E702
	tests/test_svg.py: E231
	kbve/proto/*_pb2*.py: E501, E303, F401, E261, W504, E302, W291, E271, E211, E111, E225, E231, F541, E114, E128
